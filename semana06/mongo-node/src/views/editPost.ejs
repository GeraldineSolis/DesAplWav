<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Publicación</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav>
        <div class="nav-wrapper container">
            <a href="/posts" class="brand-logo"><i class="material-icons">arrow_back</i> Volver</a>
        </div>
    </nav>

    <div class="container" style="margin-top: 50px;">
        <div class="row">
            <div class="col s12 m8 offset-m2">
                <div class="form-section">
                    <h4 class="center-align" style="color: #38bdf8; font-weight: 600;">Editar Post</h4>
                    <p class="center-align" style="color: #94a3b8;">Actualiza la información de tu publicación</p>
                    
                    <form action="/posts/update/<%= post._id %>" method="POST" style="margin-top: 30px;">
                        <div class="input-field">
                            <i class="material-icons prefix">title</i>
                            <input name="title" id="title" type="text" value="<%= post.title %>" required minlength="5" maxlength="30">
                            <label for="title" class="active">Título (5-30 caracteres)</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">article</i>
                            <textarea name="content" id="content" class="materialize-textarea" required minlength="10"><%= post.content %></textarea>
                            <label for="content" class="active">Contenido</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">image</i>
                            <input name="imageUrl" id="imageUrl" type="text" value="<%= post.imageUrl %>">
                            <label for="imageUrl" class="active">URL de la imagen</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">label</i>
                            <input name="hashtags" id="hashtags" type="text" value="<%= post.hashtags.join(', ') %>">
                            <label for="hashtags" class="active">Hashtags (separados por coma)</label>
                        </div>

                        <div class="center-align" style="margin-top: 40px;">
                            <button class="btn-large waves-effect waves-light" type="submit">
                                Actualizar Post <i class="material-icons right">save</i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>