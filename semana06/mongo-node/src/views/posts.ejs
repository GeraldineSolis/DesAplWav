<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - Post</title>
  <!-- Importar Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <!-- Iconos de Google -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="dark-theme">
  <nav>
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo"><i class="material-icons">share</i>SocialDev</a>
      <ul class="right hide-on-med-and-down">
        <li><a href="/posts" class="active">Feed Global</a></li>
        <li><a href="/posts/new" class="btn blue accent-3">Nuevo Post</a></li>
      </ul>
    </div>
  </nav>

  <main class="container" style="margin-top: 50px;">
    <div class="row">
      <div class="col s12 m10 offset-m1 l8 offset-l2">
        <div class="form-section z-depth-3">
          <h5 style="font-weight: 600; color: #38bdf8; margin-bottom: 25px;">
            <i class="material-icons left">create</i> Comparte algo con la comunidad
          </h5>

          <form action="/posts/create" method="POST">
            <input type="hidden" name="userId" value="65f1a2b3c4d5e6f7a8b9c0d1">

            <div class="input-field">
              <input name="title" id="new_title" type="text" required minlength="5" maxlength="30">
              <label for="new_title">Título impactante (5-30 caracteres)</label>
            </div>

            <div class="input-field">
              <textarea name="content" id="new_content" class="materialize-textarea" required minlength="10"></textarea>
              <label for="new_content">¿En qué estás trabajando hoy?</label>
            </div>

            <div class="row">
              <div class="input-field col s12 m6">
                <input name="imageUrl" id="new_image" type="text" placeholder="https://ejemplo.com/foto.jpg">
                <label for="new_image" class="active">URL de Imagen (Opcional)</label>
              </div>
              <div class="input-field col s12 m6">
                <input name="hashtags" id="new_tags" type="text" placeholder="node, js, tecsup, dev">
                <label for="new_tags" class="active">Hashtags (mínimo 5)</label>
              </div>
            </div>

            <div class="right-align">
              <button class="btn-large waves-effect waves-light" type="submit">
                Publicar Post <i class="material-icons right">send</i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="divider" style="background-color: rgba(255,255,255,0.1); margin: 40px 0;"></div>

    <div class="center-align" style="margin-bottom: 60px;">
      <h2 style="font-weight: 800;">Explora Ideas</h2>
      <p style="color: #94a3b8; font-size: 1.2rem;">Comunidad de desarrolladores Tecsup</p>
    </div>

    <div class="row">
      <% posts.forEach(post=> { %>
        <div class="col s12 m6 l4">
          <div class="card custom-card">
            <div class="card-image">
              <img src="<%= post.imageUrl || 'https://source.unsplash.com/random/800x600?tech,' + post._id %>"
                style="filter: brightness(0.8);">
            </div>
            <div class="card-content">
              <span class="card-title">
                <%= post.title %>
              </span>
              <p style="color: #cbd5e1;">
                <%= post.content %>
              </p>
              <div style="margin-top: 20px;">
                <% post.hashtags.forEach(tag=> { %>
                  <span class="chip">#<%= tag %></span>
                  <% }) %>
              </div>
            </div>
            <div class="card-action" style="border-top: 1px solid rgba(255,255,255,0.05);">
              <div class="valign-wrapper">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=<%= post.user ? post.user.name : 'anon' %>"
                  class="circle" style="width: 30px; margin-right: 10px;">
                <span class="grey-text text-lighten-1">
                  <%= post.user ? post.user.name : 'Usuario' %>
                </span>

                <div class="right-align" style="flex-grow: 1;">
                  <a href="/posts/edit/<%= post._id %>" class="blue-text"><i class="material-icons">edit_note</i></a>
                  <a href="/posts/delete/<%= post._id %>" class="red-text"><i
                      class="material-icons">delete_sweep</i></a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
    </div>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      M.AutoInit();

      M.updateTextFields();
    });
  </script>
</body>

</html>